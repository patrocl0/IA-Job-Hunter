+  assert.equal((await patch({status:'Oferta'},'2')).status,404);assert.equal((await patch({status:'Oferta'},'99999999999999999999')).status,400);
+  assert.equal((await fetch(base+'/api/analyses?followUp=due&today=2026-02-30')).status,400);
+  assert.equal((await fetch(base+'/api/analyses?followUp=due&today=2026-10-16')).status,200);assert.deepEqual(lastQuery.args,['2026-10-16']);assert.match(lastQuery.sql,/WHERE.*NOT IN.*<= \$1 ORDER BY.*LIMIT 100/);
