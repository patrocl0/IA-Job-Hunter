{
  "name": "ai-job-hunter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "npm test --workspace backend && npm test --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "build:demo": "npm run build:demo --workspace frontend",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/test/**/*.js\" \"frontend/src/**/*.{ts,tsx,mjs,css}\" \"frontend/test/*.mjs\" \"frontend/vite.config.ts\" \"shared/**/*.mjs\""
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
