# Modo demo: no necesita clave y no envía datos a OpenAI.
AI_MODE=demo
# Para IA real: AI_MODE=openai, clave y modelo habilitado en tu cuenta.
OPENAI_API_KEY=
OPENAI_MODEL=
# Clave local de PostgreSQL. Cambiar antes de usar datos reales.
POSTGRES_PASSWORD=cambia_esta_clave_local

# Origen exacto desde el que abres la aplicación (sin barra final).
APP_ORIGIN=http://localhost:8080
# Habilita registro de cuentas nuevas. La cuenta propietaria se activa por terminal.
ALLOW_REGISTRATION=false
